{
  "name": "crossfade",
  "version": "0.4.0",
  "description": "Move your Yandex Music library to YouTube Music: liked tracks, playlists and albums",
  "license": "MIT",
  "author": "Vladimir Rainov (https://vladr.tech)",
  "repository": "github:PeGoPaz/crossfade",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "crossfade": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "crossfade": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check": "biome check src test",
    "format": "biome check --write src test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
